<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:clipToPadding="false"
    android:fillViewport="true"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="32dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="28dp"
            android:paddingEnd="24dp"
            android:paddingBottom="28dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <ImageView
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:contentDescription="@string/app_name"
                    android:src="@drawable/ic_mark" />

                <ImageButton
                    android:id="@+id/add_phone"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="end|center_vertical"
                    android:background="?android:attr/selectableItemBackgroundBorderless"
                    android:contentDescription="Add phone"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_qr" />
            </FrameLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:letterSpacing="-0.03"
                android:text="@string/app_name"
                android:textColor="@color/on_navy"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Find your Mac"
                android:textColor="@android:color/white"
                android:textSize="18sp" />

            <TextView
                android:id="@+id/next"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/on_navy_muted"
                android:textSize="15sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/phone_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_card"
            android:elevation="6dp"
            android:orientation="vertical"
            android:outlineProvider="background"
            android:padding="20dp">

            <TextView
                style="@style/Text.SWIFT.CardTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="This phone" />

            <TextView
                style="@style/Text.SWIFT.Help"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="This is the name your Mac sees. A model name does not replace it." />

            <EditText
                android:id="@+id/phone_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_field"
                android:hint="Phone name"
                android:importantForAutofill="no"
                android:inputType="text"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/ink"
                android:textColorHint="@color/muted"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/save_name"
                style="@style/Widget.SWIFT.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:layout_marginTop="8dp"
                android:text="Save name" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/pair_section"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_card"
            android:elevation="6dp"
            android:orientation="vertical"
            android:outlineProvider="background"
            android:padding="20dp">

            <TextView
                style="@style/Text.SWIFT.CardTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Your Mac" />

            <TextView
                style="@style/Text.SWIFT.Help"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Same Wi-Fi. Tap the Mac when it appears." />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/find"
                style="@style/Widget.SWIFT.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:layout_marginTop="16dp"
                android:text="Find Mac" />

            <LinearLayout
                android:id="@+id/macs"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="vertical" />

            <EditText
                android:id="@+id/link"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_field"
                android:hint="Or paste the pairing link, or type the 8 digits"
                android:importantForAutofill="no"
                android:inputType="textUri"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="@color/ink"
                android:textColorHint="@color/muted"
                android:textSize="15sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/pair_link"
                style="@style/Widget.SWIFT.Button.Quiet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:layout_marginTop="8dp"
                android:text="Pair" />
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/pair_again"
            style="@style/Widget.SWIFT.Button.Quiet"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
                android:minHeight="56dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="20dp"
            android:layout_marginEnd="20dp"
            android:text="Pair a different Mac"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/remove_mac"
            style="@style/Widget.SWIFT.Button.Danger"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
                android:minHeight="56dp"
            android:layout_marginStart="20dp"
            android:layout_marginTop="8dp"
            android:layout_marginEnd="20dp"
            android:text="Remove this Mac"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_card"
            android:elevation="6dp"
            android:orientation="vertical"
            android:outlineProvider="background"
            android:padding="20dp">

            <TextView
                style="@style/Text.SWIFT.CardTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Clipboard" />

            <TextView
                android:id="@+id/access_help"
                style="@style/Text.SWIFT.Help"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/access"
                style="@style/Widget.SWIFT.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:layout_marginTop="16dp"
                android:text="Turn on clipboard access" />

            <TextView
                android:id="@+id/background_help"
                style="@style/Text.SWIFT.Help"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/background"
                style="@style/Widget.SWIFT.Button.Quiet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:layout_marginTop="10dp"
                android:text="Keep running in the background" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="20dp"
            android:layout_marginTop="14dp"
            android:layout_marginEnd="20dp"
            android:background="@drawable/bg_card"
            android:elevation="6dp"
            android:orientation="vertical"
            android:outlineProvider="background"
            android:padding="20dp">

            <TextView
                style="@style/Text.SWIFT.CardTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="iPhone" />

            <TextView
                android:id="@+id/photo_status"
                style="@style/Text.SWIFT.Help"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp" />

            <ImageView
                android:id="@+id/photo_qr"
                android:layout_width="220dp"
                android:layout_height="220dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_field"
                android:contentDescription="Code for the iPhone camera"
                android:padding="12dp"
                android:scaleType="fitCenter" />

            <TextView
                android:id="@+id/photo_address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:textColor="@color/muted"
                android:textIsSelectable="true"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/photo_send"
                style="@style/Widget.SWIFT.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:layout_marginTop="16dp"
                android:text="Send photos" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/photo_new"
                style="@style/Widget.SWIFT.Button.Quiet"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:layout_marginTop="8dp"
                android:text="New link" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
